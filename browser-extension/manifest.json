{
  "manifest_version": 3,
  "name": "Study OS Focus Tracker",
  "description": "Tracks your active tab to determine your focus score during study sessions.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://study-os-five-tau.vercel.app/*",
    "https://*.supabase.co/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://study-os-five-tau.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
